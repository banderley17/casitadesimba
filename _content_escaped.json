r:</p>\n    <ul>\n      <li><a href=\"https://support.google.com/chrome/answer/95647\" target=\"_blank\" rel=\"noopener noreferrer\">Google Chrome</a></li>\n      <li><a href=\"https://support.mozilla.org/es/kb/habilitar-y-deshabilitar-cookies\" target=\"_blank\" rel=\"noopener noreferrer\">Mozilla Firefox</a></li>\n      <li><a href=\"https://support.apple.com/es-es/guide/safari/sfri11471/mac\" target=\"_blank\" rel=\"noopener noreferrer\">Safari</a></li>\n    </ul>\n    <h3>Contacto</h3>\n    <p>Para cualquier consulta sobre nuestra política de cookies escríbenos a lacasitadesimba04@gmail.com.</p>\n  </div>\n</div>\n\n<!-- WHATSAPP BUBBLE -->\n<a class=\"wa-bubble\" id=\"waBubble\" href=\"https://wa.me/34613753680?text=Hola!%20Me%20gustar%C3%ADa%20reservar%20una%20plaza%20en%20La%20Casita%20de%20Simba%20%F0%9F%90%BE\" target=\"_blank\" rel=\"noopener noreferrer\">\n  <button class=\"wa-bubble-close\" id=\"waBubbleClose\" aria-label=\"Cerrar\">✕</button>\n  <div class=\"wa-bubble-row\">\n    <span class=\"wa-dot\"></span>\n    <div class=\"wa-bubble-text\"><strong>Helena</strong> — ¡Hola! 👋<br>¿Quieres reservar una plaza en La Casita de Simba? 🐾</div>\n  </div>\n</a>\n\n<!-- WHATSAPP -->\n<a href=\"https://wa.me/34613753680?text=Hola!%20Me%20gustar%C3%ADa%20reservar%20una%20plaza%20en%20La%20Casita%20de%20Simba%20%F0%9F%90%BE\" class=\"wa-float\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"WhatsApp\">\n  <svg viewBox=\"0 0 32 32\" xmlns=\"http://www.w3.org/2000/svg\">\n    <path d=\"M16 .5C7.439.5.5 7.439.5 16c0 2.722.702 5.275 1.93 7.497L.5 31.5l8.284-1.896A15.454 15.454 0 0016 31.5C24.561 31.5 31.5 24.561 31.5 16S24.561.5 16 .5zm0 28.333a13.775 13.775 0 01-7.027-1.92l-.504-.299-5.218 1.194 1.237-5.072-.329-.52A13.743 13.743 0 012.167 16C2.167 8.359 8.359 2.167 16 2.167S29.833 8.359 29.833 16 23.641 28.833 16 28.833zm7.551-10.336c-.414-.207-2.449-1.208-2.829-1.346-.38-.138-.656-.207-.933.207-.277.414-1.071 1.346-1.313 1.623-.242.277-.483.311-.897.104-.414-.207-1.748-.644-3.33-2.053-1.23-1.097-2.061-2.451-2.303-2.865-.242-.414-.026-.638.182-.844.187-.185.414-.483.621-.725.207-.242.277-.414.414-.69.138-.277.069-.518-.035-.725-.104-.207-.933-2.248-1.277-3.078-.337-.808-.679-.698-.933-.711l-.794-.014c-.277 0-.725.104-1.105.518-.38.414-1.45 1.415-1.45 3.452s1.485 4.004 1.692 4.28c.207.277 2.923 4.464 7.083 6.259 4.16 1.795 4.16 1.197 4.91 1.122.75-.069 2.449-.999 2.795-1.968.346-.968.346-1.797.242-1.968-.104-.173-.38-.277-.794-.484z\"/>\n  </svg>\n</a>\n\n<script>\n// Slideshow hero\n(function() {\n  const slides = document.querySelectorAll('.hero-slide');\n  let cur = 0;\n  setInterval(() => {\n    slides[cur].classList.remove('active');\n    cur = (cur + 1) % slides.length;\n    slides[cur].classList.add('active');\n  }, 4500);\n})();\n\n// Patas flotantes\n(function() {\n  const wrap = document.getElementById('patasWrap');\n  const emojis = ['🐾','🐾','🐾','🐶','🐾','🐾'];\n  emojis.forEach((em, i) => {\n    const el = document.createElement('span');\n    el.className = 'pata';\n    el.textContent = em;\n    const left = 8 + Math.random() * 84;\n    const dur  = 9 + Math.random() * 10;\n    const delay = i * 1.8;\n    const rot  = -25 + Math.random() * 50;\n    el.style.cssText = `left:${left}%;bottom:-5%;--rot:${rot}deg;animation-duration:${dur}s;animation-delay:${delay}s;font-size:${1.4+Math.random()*1.4}rem;`;\n    wrap.appendChild(el);\n  });\n})();\n\n// Header: transparente sobre hero, blanco al hacer scroll\nwindow.addEventListener('scroll', () => {\n  document.getElementById('header').classList.toggle('scrolled', window.scrollY > 80);\n});\n\n// Menú móvil\ndocument.getElementById('menuBtn').addEventListener('click', () => {\n  const nav = document.getElementById('nav');\n  const header = document.getElementById('header');\n  const isOpen = nav.classList.toggle('open');\n  header.classList.toggle('menu-open', isOpen);\n  document.getElementById('menuBtn').textContent = isOpen ? '✕' : '☰';\n});\ndocument.querySelectorAll('nav a').forEach(a => {\n  a.addEventListener('click', () => {\n    document.getElementById('nav').classList.remove('open');\n    document.getElementById('header').classList.remove('menu-open');\n    document.getElementById('menuBtn').textContent = '☰';\n  });\n});\n\n// Reveal al scroll con stagger en grids\nconst gridMap = [\n  ['.servicios-grid',  '.servicio-card'],\n  ['.porq-grid',       '.porq-item'],\n  ['.testimonios-grid','.testimonio'],\n  ['.precios-grid',    '.precio-card'],\n];\nconst observer = new IntersectionObserver(entries => {\n  entries.forEach(e => {\n    if (!e.isIntersecting) return;\n    e.target.classList.add('visible');\n    for (const [grid, child] of gridMap) {\n      if (e.target.matches(grid)) {\n        e.target.querySelectorAll(child).forEach((c, i) => {\n          c.style.animationDelay = `${.05 + i * .1}s`;\n          c.classList.add('reveal-child');\n        });\n      }\n    }\n    observer.unobserve(e.target);\n  });\n}, { threshold: 0.1 });\ndocument.querySelectorAll('.reveal').forEach(el => observer.observe(el));\n\n// Selección de tarifa\ndocument.querySelectorAll('.precio-card').forEach(card => {\n  card.addEventListener('click', () => {\n    document.querySelectorAll('.precio-card').forEach(c => c.classList.remove('selected'));\n    card.classList.add('selected');\n  });\n});\n\n\n// 3D tilt en cards\ndocument.querySelectorAll('.servicio-card, .porq-item, .testimonio').forEach(card => {\n  card.addEventListener('mousemove', e => {\n    const r = card.getBoundingClientRect();\n    const x = (e.clientX - r.left - r.width  / 2) / (r.width  / 2);\n    const y = (e.clientY - r.top  - r.height / 2) / (r.height / 2);\n    card.style.transform = `perspective(700px) rotateX(${-y * 4}deg) rotateY(${x * 4}deg) translateY(-10px)`;\n    card.style.transition = 'transform .08s';\n  });\n  card.addEventListener('mouseleave', () => {\n    card.style.transform = '';\n    card.style.transition = 'transform .45s cubic-bezier(.22,1,.36,1), box-shadow .35s';\n  });\n});\n\n// Contador animado en stats del hero\nfunction countUp(el) {\n  const raw = el.textContent.trim();\n  const num = parseInt(raw.replace(/\\D/g, ''));\n  const prefix = raw.match(/^[^\\d]*/)?.[0] || '';\n  const suffix = raw.match(/[^\\d]*$/)?.[0] || '';\n  if (isNaN(num)) return;\n  let startTs = null;\n  const dur = 1400;\n  (function step(ts) {\n    if (!startTs) startTs = ts;\n    const p = Math.min((ts - startTs) / dur, 1);\n    const ease = 1 - Math.pow(1 - p, 3);\n    el.textContent = prefix + Math.floor(ease * num) + suffix;\n    if (p < 1) requestAnimationFrame(step);\n  })(performance.now());\n}\nconst statsEl = document.querySelector('.hero-stats');\nif (statsEl) {\n  new IntersectionObserver(entries => {\n    if (entries[0].isIntersecting) {\n      statsEl.querySelectorAll('.stat-num').forEach(countUp);\n    }\n  }, { threshold: .6 }).observe(statsEl);\n}\n\n// Formulario → WhatsApp\nfunction enviar(e) {\n  e.preventDefault();\n  var n       = document.getElementById('fn').value.trim();\n  var tel     = document.getElementById('ftel').value.trim();\n  var perro   = document.getElementById('fperro').value.trim();\n  var serv    = document.getElementById('fservicio').value;\n  var entrada = document.getElementById('fentrada').value;\n  var salida  = document.getElementById('fsalida').value;\n  var desc    = document.getElementById('fdesc').value.trim();\n\n  var msg = 'Hola Helena, quiero hacer una reserva en La Casita de Simba 🐾\\n\\n';\n  msg += '👤 *Nombre:* ' + n + '\\n';\n  msg += '📞 *Teléfono:* ' + (tel || 'No indicado') + '\\n';\n  msg += '🐶 *Perro:* ' + perro + '\\n';\n  msg += '🏷️ *Servicio:* ' + serv + '\\n';\n  if (entrada) msg += '📅 *Entrada:* ' + entrada + '\\n';\n  if (salida)  msg += '📅 *Salida:* '  + salida  + '\\n';\n  if (desc)    msg += '💬 *Sobre mi perro:* ' + desc;\n\n  window.open('https://wa.me/34613753680?text=' + encodeURIComponent(msg), '_blank');\n\n  var btn = e.target.querySelector('.btn-form');\n  btn.disabled = true;\n  btn.textContent = '✅ Abriendo WhatsApp…';\n  btn.style.background = '#5AA882';\n  setTimeout(function() {\n    e.target.reset();\n    btn.disabled = false;\n    btn.textContent = '💬 Enviar por WhatsApp';\n    btn.style.background = '';\n  }, 2500);\n}\n\n// Lightbox galería\n(function() {\n  var items = document.querySelectorAll('.galeria-item[data-src]');\n  var overlay = document.getElementById('lbOverlay');\n  var img = document.getElementById('lbImg');\n  var counter = document.getElementById('lbCounter');\n  var cur = 0;\n  var srcs = Array.from(items).map(function(el){ return el.dataset.src; });\n  var caps = Array.from(items).map(function(el){ return el.dataset.caption || ''; });\n\n  function open(i) {\n    cur = i;\n    img.src = srcs[i];\n    img.alt = caps[i];\n    counter.textContent = (i + 1) + ' / ' + srcs.length;\n    overlay.classList.add('open');\n    document.body.style.overflow = 'hidden';\n  }\n  function close() {\n    overlay.classList.remove('open');\n    document.body.style.overflow = '';\n  }\n  function prev() { open((cur - 1 + srcs.length) % srcs.length); }\n  function next() { open((cur + 1) % srcs.length); }\n\n  items.forEach(function(el, i) { el.addEventListener('click', function(){ open(i); }); });\n  document.getElementById('lbClose').addEventListener('click', close);\n  document.getElementById('lbPrev').addEventListener('click', function(e){ e.stopPropagation(); prev(); });\n  document.getElementById('lbNext').addEventListener('click', function(e){ e.stopPropagation(); next(); });\n  overlay.addEventListener('click', function(e){ if(e.target === overlay || e.target === img) return; close(); });\n  img.addEventListener('click', function(e){ e.stopPropagation(); next(); });\n  document.addEventListener('keydown', function(e){\n    if(!overlay.classList.contains('open')) return;\n    if(e.key === 'Escape') close();\n    if(e.key === 'ArrowLeft') prev();\n    if(e.key === 'ArrowRight') next();\n  });\n})();\n\n// WhatsApp bubble — aparece a los 10 segundos, se cierra al pulsar X\n(function() {\n  const bubble = document.getElementById('waBubble');\n  const closeBtn = document.getElementById('waBubbleClose');\n  const waBtn = document.querySelector('.wa-float');\n  let shown = false;\n\n  setTimeout(() => {\n    if (!shown) { bubble.classList.add('show'); shown = true; }\n  }, 10000);\n\n  closeBtn.addEventListener('click', (e) => {\n    e.preventDefault();\n    e.stopPropagation();\n    bubble.classList.remove('show');\n  });\n\n  // Al pulsar el botón flotante también abre el bubble si no estaba visible\n  waBtn.addEventListener('click', (e) => {\n    if (!shown) { e.preventDefault(); bubble.classList.add('show'); shown = true; }\n  });\n})();\n\n// ── COUNTDOWN JUNIO ──\n(function() {\n  var end = new Date('2026-07-01T00:00:00');\n  function pad(n) { return String(n).padStart(2,'0'); }\n  function tick() {\n    var now = new Date(), diff = end - now;\n    if (diff <= 0) {\n      var cd = document.getElementById('jcDays');\n      if (cd) cd.closest('.junio-countdown').innerHTML = '<div style=\"font-size:1rem;font-weight:700;opacity:.9;\">¡Oferta finalizada — gracias por confiar en nosotros! 🐾</div>';\n      return;\n    }\n    var d = Math.floor(diff/86400000);\n    var h = Math.floor((diff%86400000)/3600000);\n    var m = Math.floor((diff%3600000)/60000);\n    var s = Math.floor((diff%60000)/1000);\n    var eD=document.getElementById('jcDays'), eH=document.getElementById('jcHours'), eM=document.getElementById('jcMins'), eS=document.getElementById('jcSecs');\n    if(eD) eD.textContent=pad(d);\n    if(eH) eH.textContent=pad(h);\n    if(eM) eM.textContent=pad(m);\n    if(eS) eS.textContent=pad(s);\n  }\n  tick(); setInterval(tick,1000);\n})();\n\n// ── LANGUAGE SWITCHER ──\n(function() {\n  var tr = {\n    es: {\n      'nav-simba':'Sobre Simba','nav-serv':'Servicios','nav-gal':'Galería','nav-prec':'Tarifas','nav-cta':'Reservar plaza',\n      'hero-pill':'🏅 Guarderia Canina Diurna · Madrid','hero-badge':'🐾 Donde tu perro es el rey',\n      'hero-tagline':'Cuidado, juego y cariño como en casa',\n      'hero-desc':'Un hogar lleno de amor donde tu peludo se siente feliz, acompañado y seguro mientras estás trabajando o realizando otras actividades.',\n      'hero-btn1':'🐶 Reservar plaza','hero-btn2':'Ver servicios',\n      'stat1':'Perritos felices','stat2':'Valoración media','stat3':'Fotos al día',\n      'sobre-label':'El anfitrión','sobre-h2':'Hola, soy Simba 🐾',\n      'sobre-p1':'Soy un Shar Pei tranquilo y cariñoso, y este lugar es mi hogar. Mi cuidadora Helena creó La Casita de Simba pensando en todos los perritos que, como yo, necesitan algo más que una residencia: <strong>un hogar donde sentirse queridos</strong>.',\n      'sobre-p2':'Aquí cada perro es tratado como uno más de la familia. Nada de jaulas, nada de estrés. Solo juegos, cariño y mucha diversión.',\n      'check1':'<span class=\"check-icon\">✓</span>Cuidado personalizado para cada perro',\n      'check2':'<span class=\"check-icon\">✓</span>Ambiente familiar sin estrés ni jaulas',\n      'check3':'<span class=\"check-icon\">✓</span>Socialización con otros perritos',\n      'check4':'<span class=\"check-icon\">✓</span>Actualizaciones y fotos durante el día',\n      'check5':'<span class=\"check-icon\">✓</span>Celebraciones de cumpleaños perrunos 🎂',\n      'serv-label':'Lo que ofrecemos','serv-h2':'Servicios Premium 🐾',\n      'serv-desc':'Todo lo que tu perro necesita para pasar el mejor día de su vida mientras tú tranquilamente trabajas o realizas otras actividades.',\n      'serv1-h3':'Estancia Diurna','serv1-p':'Tu perro disfrutará del día jugando, socializando y recibiendo atención personalizada. Recogida y entrega a domicilio disponible (consulta disponibilidad).',\n      \n      'serv3-h3':'Fotos y Vídeos','serv3-p':'Te enviamos fotos y vídeos de tu peludo durante el día para que estés siempre tranquila. ¡Verás lo bien que lo pasa!',\n      'serv4-h3':'Cumpleaños Perrunos','serv4-p':'Celebraciones especiales con decoración, tarta y fotos. ¡Porque tu peludo también merece su fiesta!',\n      'serv5-h3':'Bono Semanal','serv5-p':'Elige los días que necesitas de cada semana y paga solo por lo que usas. Perfecto para rutinas variables y agendas cambiantes.',\n      'serv6-h3':'Bono Mensual','serv6-p':'La opción más económica para clientes habituales. Precio especial al contratar el mes completo. Cuéntanos tu rutina y lo diseñamos a tu medida.',\n      'serv-rutina':'🔄 <strong>Nos adaptamos a tu rutina.</strong> Dinos tus horarios y diseñamos el servicio perfecto para ti y tu peludo — sin estrés y sin complicaciones.',\n      'porq-label':'¿Por qué nosotros?','porq-h2':'Lo que nos hace diferentes 🐾',\n      'porq-desc':'No somos una residencia masificada. Tu perro es uno más de la familia, no un número más.',\n      'porq1-h3':'Sin jaulas, nunca','porq1-p':'Tu perro tendrá espacio libre para moverse, jugar y descansar. Sin boxes, sin confinamientos.',\n      'porq2-h3':'Fotos y vídeos en directo','porq2-p':'Te enviamos fotos y vídeos por WhatsApp durante el día para que estés tranquila en todo momento.',\n      'porq3-h3':'Atención 1 a 1','porq3-p':'Máximo 5 perritos a la vez. Tu peludo no es uno más del montón — es el protagonista del día.',\n      'porq4-h3':'Recogida a domicilio','porq4-p':'Recogemos y devolvemos a tu perro en tu puerta. Sin que tengas que moverte de casa.',\n      'porq5-h3':'Helena siempre disponible','porq5-p':'Cualquier duda o novedad, Helena responde por WhatsApp al momento. Siempre comunicados.',\n      'porq6-h3':'+200 familias confían en nosotros','porq6-p':'Desde 2022 cuidando peludos en Madrid con valoración de 5 estrellas. Sin una sola queja.',\n      'gal-label':'Un día en La Casita','gal-h2':'Así de bien lo pasan 📸',\n      'gal-desc':'Imágenes reales de nuestros peludos disfrutando en La Casita de Simba.',\n      'gal-ig':'Seguir en Instagram · @lacasitadesimba',\n      'prec-label':'Sin sorpresas','prec-h2':'Tarifas claras 💎',\n      'prec-desc':'Precios transparentes y sin letra pequeña. Lo que ves es lo que pagas.',\n      'prec1-h3':'Estancia Diurna','prec1-por':'por día completo','prec1-li1':'De 8h a 20h','prec1-li2':'Comida incluida','prec1-li3':'Fotos del día','prec1-li4':'Fotos y Vídeos','prec1-cta':'Reservar',\n      \n      'prec3-h3':'Eventos y Cumpleaños','prec3-num':'A consultar','prec3-por':'pack personalizado','prec3-li1':'Decoración incluida','prec3-li2':'Tarta perruna','prec3-li3':'Sesión de fotos','prec3-li4':'Invitados peludos','prec3-cta':'Consultar',\n      'prec4-h3':'Bono Semanal','prec4-por':'7 días','prec4-li1':'7 días a tu elección','prec4-li2':'Horario flexible','prec4-li3':'Chuches y snacks incluidos','prec4-li4':'Fotos y vídeos diarios','prec4-cta':'Consultar',\n      'prec5-h3':'Bono Mensual','prec5-por':'20 días al mes','prec5-li1':'Días adaptados a tu rutina','prec5-li2':'Precio especial habitual','prec5-li3':'Chuches y snacks incluidos','prec5-li4':'Fotos y vídeos diarios','prec5-cta':'Consultar',\n      'tbl-desde':'desde',\n      'tbl-ttl':'📋 Tarifa Estándar','tbl-th1':'Servicio','tbl-th2':'Precio','tbl-th3':'Incluye',\n      'tbl-s1n':'Estancia Diurna','tbl-s1u':'/día','tbl-s1d':'8h–20h · comida · fotos','tbl-shn':'Estancia por Horas','tbl-shu':'/hora','tbl-shd':'Flexible · comida · fotos',\n      \n      'tbl-s3n':'Bono Semanal','tbl-s3u':'/semana','tbl-s3d':'5 días · horario flexible · fotos',\n      'tbl-s4n':'Bono Mensual','tbl-s4u':'/mes','tbl-s4d':'20 días · precio especial · fotos',\n      'tbl-s5n':'Cumpleaños / Evento','tbl-s5p':'A consultar','tbl-s5d':'Decoración · tarta · fotos',\n      'tbl-nota':'🔄 Nos adaptamos a tu rutina — consulta tu bono personalizado.',\n      'prec-ref-box':'<strong style=\"color:#1a2040;\">⏱️ Precios de estancia por horas:</strong><br class=\"movil-br\">Consulta tu precio personalizado por WhatsApp',\n\n\n      \n      \n      'test-label':'Lo que dicen','test-h2':'Familias que confían en nosotros ❤️',\n      'test-desc':'Las opiniones de quienes más importan: los dueños de nuestros peludos.',\n      'test1-p':'\"Mi perro volvió feliz y súper tranquilo. Helena tiene un cariño increíble por los animales. Nunca lo llevaría a otro sitio.\"',\n      'test1-perro':'Dueña de Toby 🐕',\n      'test2-p':'\"La mejor guarderia canina sin jaulas que hemos probado en Madrid. Las fotos que nos manda Helena durante el día nos dejan muy tranquilos.\"',\n      'test2-perro':'Dueño de Luna 🐩',\n      'test3-p':'\"Las fotos que nos mandaba Helena durante el día nos dieron muchísima tranquilidad. Y llegó a casa agotada de tanto jugar, ¡señal de que lo pasó genial!\"',\n      'test3-perro':'Dueña de Nala 🐾',\n      'cont-label':'🐾 Reservas y ubicación','cont-h2':'Reserva y encuéntranos',\n      'cont-desc':'Rellena el formulario y te confirmamos disponibilidad en menos de 24h. También puedes escribirnos por WhatsApp.',\n      'form-h3':'🐶 Datos de la reserva',\n      'lbl-nombre':'Tu nombre','ph-nombre':'María García','lbl-tel':'Teléfono / WhatsApp',\n      'lbl-perro':'Nombre del perro','ph-perro':'Max','lbl-serv':'Servicio',\n      'opt1':'Estancia (12h)','opt2':'8 Horas','opt3':'1 Hora','opt4':'Bono Semanal','opt5':'Bono Mensual','opt6':'Cumpleaños / Evento',\n      'lbl-entrada':'Fecha de entrada','lbl-salida':'Fecha de salida',\n      'lbl-desc':'Cuéntanos sobre tu perro','ph-desc':'Raza, edad, carácter, si es sociable con otros perros...',\n      'form-btn':'💬 Enviar por WhatsApp',\n      'info-dir':'Dirección','info-tel':'Teléfono','info-email':'Email','info-hora':'Horario',\n      'info-hora-val':'Lun–Vie: 08:00–20:00 · Fines de semana: consultar',\n      'cont-wa':'💬 Escríbenos por WhatsApp',\n      'foot-desc':'Guarderia Canina Diurna premium en Madrid. Cuidado con amor desde 2022.',\n      'foot-serv':'Servicios','foot-s1':'Estancia Diurna','foot-s2':'Fotos y Vídeos','foot-s3':'Fotos y Vídeos','foot-s4':'Cumpleaños Perrunos',\n      'foot-cont':'Contacto','foot-copy':'© 2026 La Casita de Simba · Madrid','foot-love':'Hecho con ❤️ para los peludos de Madrid',\n      'bubble':'¿Quieres reservar una plaza en La Casita de Simba? 🐾','lang-btn':'🇬🇧 EN',\n      'caps':['Jugando juntos 🐾','Hora del recreo 🎾','Descanso en familia 😴','Amigos peludos 🐕','¡Qué feliz estoy! 🐶','Explorando la casita 🌿','Momentos especiales 💕','Como en casa 🏡']\n    },\n    en: {\n      'nav-simba':'About Simba','nav-serv':'Services','nav-gal':'Gallery','nav-prec':'Rates','nav-cta':'Book a spot',\n      'hero-pill':'🏅 Dog Day Care · Madrid','hero-badge':'🐾 Where your dog is king',\n      'hero-tagline':'Care, play and love like home',\n      'hero-desc':\"A home full of love where your furry friend feels happy, safe and cared for while you work or go about your day.\",\n      'hero-btn1':'🐶 Book a spot','hero-btn2':'See services',\n      'stat1':'Happy pups','stat2':'Average rating','stat3':'Photos a day',\n      'sobre-label':'The host','sobre-h2':\"Hello, I'm Simba 🐾\",\n      'sobre-p1':\"I'm a calm and loving Shar Pei, and this place is my home. My carer Helena created La Casita de Simba for all the dogs who, like me, need more than just a kennel: <strong>a home where they feel loved</strong>.\",\n      'sobre-p2':'Here every dog is treated as part of the family. No cages, no stress. Just play, love and lots of fun.',\n      'check1':'<span class=\"check-icon\">✓</span>Personalised care for every dog',\n      'check2':'<span class=\"check-icon\">✓</span>Family atmosphere, cage-free and stress-free',\n      'check3':'<span class=\"check-icon\">✓</span>Socialisation with other dogs',\n      'check4':'<span class=\"check-icon\">✓</span>Daily updates and photos',\n      'check5':'<span class=\"check-icon\">✓</span>Dog birthday celebrations 🎂',\n      'serv-label':'What we offer','serv-h2':'Premium Services 🐾',\n      'serv-desc':'Everything your dog needs to have the best day of its life while you work in peace.',\n      'serv1-h3':'Day Care','serv1-p':'Your dog will enjoy the day playing, socialising and receiving personalised attention. Pick-up and drop-off available.',\n      \n      'serv3-h3':'Photos & Videos','serv3-p':\"We send you photos and videos of your furry friend throughout the day so you're always at ease. You'll see how much fun they're having!\",\n      'serv4-h3':'Dog Birthdays','serv4-p':'Special celebrations with decorations, cake and photos. Because your furry friend deserves their own party!',\n      'serv5-h3':'Weekly Pack','serv5-p':'Choose the days you need each week and pay only for what you use. Perfect for variable routines and changing schedules.',\n      'serv6-h3':'Monthly Pack','serv6-p':\"The most affordable option for regular clients. Special price when you book the full month. Tell us your routine and we'll design it to fit you.\",\n      'serv-rutina':\"🔄 <strong>We adapt to your routine.</strong> Tell us your schedule and we'll design the perfect service for you and your furry friend — stress-free and hassle-free.\",\n      'porq-label':'Why us?','porq-h2':'What makes us different 🐾',\n      'porq-desc':'We are not a crowded kennel. Your dog is one of the family, not just a number.',\n      'porq1-h3':'No cages, ever','porq1-p':'Your dog will have free space to move, play and rest. No boxes, no confinement.',\n      'porq2-h3':'Live photos & videos','porq2-p':\"We send you photos and videos via WhatsApp throughout the day so you're always at ease.\",\n      'porq3-h3':'1-to-1 attention','porq3-p':\"Maximum 5 dogs at a time. Your furry friend is not just another dog — they're the star of the day.\",\n      'porq4-h3':'Home pick-up','porq4-p':'We pick up and drop off your dog at your door. No need to leave home.',\n      'porq5-h3':'Helena always available','porq5-p':'Any question or update, Helena replies on WhatsApp instantly. Always in touch.',\n      'porq6-h3':'+200 families trust us','porq6-p':'Since 2022 caring for dogs in Madrid with a 5-star rating. Not a single complaint.',\n      'gal-label':'A day at La Casita','gal-h2':'This is how much fun they have 📸',\n      'gal-desc':'Real photos of our furry guests enjoying La Casita de Simba.',\n      'gal-ig':'Follow on Instagram · @lacasitadesimba',\n      'prec-label':'No surprises','prec-h2':'Clear pricing 💎',\n      'prec-desc':'Transparent pricing with no small print. What you see is what you pay.',\n      'prec1-h3':'Day Care','prec1-por':'per full day','prec1-li1':'From 8am to 8pm','prec1-li2':'Food included','prec1-li3':'Daily photos','prec1-li4':'Photos & Videos','prec1-cta':'Book',\n      \n      'prec3-h3':'Events & Birthdays','prec3-num':'Ask for price','prec3-por':'personalised pack','prec3-li1':'Decoration included','prec3-li2':'Dog-friendly cake','prec3-li3':'Photo session','prec3-li4':'Furry guests','prec3-cta':'Enquire',\n      'prec4-h3':'Weekly Pack','prec4-por':'5 full days','prec4-li1':'5 days of your choice','prec4-li2':'Flexible hours','prec4-li3':'Food included','prec4-li4':'Daily photos & videos','prec4-cta':'Enquire',\n      'prec5-h3':'Monthly Pack','prec5-por':'20 days per month','prec5-li1':'Days adapted to your routine','prec5-li2':'Special regular rate','prec5-li3':'Food included','prec5-li4':'Daily photos & videos','prec5-cta':'Enquire',\n      'tbl-desde':'from',\n      'tbl-ttl':'📋 Standard Rates','tbl-th1':'Service','tbl-th2':'Price','tbl-th3':'Includes',\n      'tbl-s1n':'Day Care','tbl-s1u':'/day','tbl-s1d':'8am–8pm · food · photos',\n      \n      'tbl-s3n':'Weekly Pack','tbl-s3u':'/week','tbl-s3d':'5 days · flexible hours · photos',\n      'tbl-s4n':'Monthly Pack','tbl-s4u':'/month','tbl-s4d':'Adapted days · special rate · photos',\n      'tbl-s5n':'Birthdays / Events','tbl-s5p':'Ask for price','tbl-s5d':'Decoration · cake · photos',\n      'tbl-nota':'🔄 We adapt to your routine — enquire about your personalised pack.',\n      'prec-ref-box':'<strong style=\"color:#1a2040;\">⏱️ Hourly care prices:</strong><br class=\"movil-br\">Ask for your personalised price on WhatsApp',\n\n\n      \n      \n      'test-label':'What they say','test-h2':'Families who trust us ❤️',\n      'test-desc':\"The opinions of those who matter most: our dogs' owners.\",\n      'test1-p':'\"My dog came back happy and super calm. Helena has an incredible love for animals. I would never take him anywhere else.\"',\n      'test1-perro':\"Toby's owner 🐕\",\n      'test2-p':'\"The best dog residence we\\'ve tried in Madrid. The daily photos Helena sends are very reassuring.\"',\n      'test2-perro':\"Luna's owner 🐩\",\n      'test3-p':'\"The daily photos Helena sent were so reassuring. She came home exhausted from all the playing — a sign she had a great time!\"',\n      'test3-perro':\"Nala's owner 🐾\",\n      'cont-label':'🐾 Bookings & location','cont-h2':'Book & find us',\n      'cont-desc':\"Fill in the form and we'll confirm availability within 24h. You can also message us on WhatsApp.\",\n      'form-h3':'🐶 Booking details',\n      'lbl-nombre':'Your name','ph-nombre':'John Smith','lbl-tel':'Phone / WhatsApp',\n      'lbl-perro':\"Dog's name\",'ph-perro':'Max','lbl-serv':'Service',\n      'opt1':'Stay (12h)','opt2':'8 Hours','opt3':'1 Hour','opt4':'Weekly Pack','opt5':'Monthly Pack','opt6':'Birthday / Event',\n      'lbl-entrada':'Check-in date','lbl-salida':'Check-out date',\n      'lbl-desc':'Tell us about your dog','ph-desc':'Breed, age, temperament, sociable with other dogs...',\n      'form-btn':'💬 Send via WhatsApp',\n      'info-dir':'Address','info-tel':'Phone','info-email':'Email','info-hora':'Hours',\n      'info-hora-val':'Mon–Fri: 08:00–20:00 · Weekends on request',\n      'cont-wa':'💬 Write us on WhatsApp',\n      'foot-desc':'Premium Dog Day Care in Madrid. Caring with love since 2022.',\n      'foot-serv':'Services','foot-s1':'Day Care','foot-s2':'Photos & Videos','foot-s3':'Photos & Videos','foot-s4':'Dog Birthdays',\n      'foot-cont':'Contact','foot-copy':'© 2026 La Casita de Simba · Madrid','foot-love':\