"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n\n<title>La Casita de Simba | Guarderia Canina Diurna sin Jaulas en Madrid</title>\n<meta name=\"description\" content=\"Guarderia canina diurna premium en Madrid sin jaulas. Cuidado personalizado, fotos y vídeos diarios, recogida a domicilio. ¡Consulta disponibilidad y precios hoy!\">\n<meta name=\"keywords\" content=\"guarderia canina diurna Madrid, guarderia canina Madrid, residencia perros Madrid, cuidado de perros Madrid, alojamiento canino Madrid, guarderia canina diurna sin jaulas, guarderia canina sin jaulas Madrid, La Casita de Simba\">\n<meta name=\"robots\" content=\"index, follow\">\n<meta name=\"author\" content=\"La Casita de Simba\">\n<link rel=\"canonical\" href=\"https://lacasitadesimba.es/\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://lacasitadesimba.es/\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://lacasitadesimba.es/\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://lacasitadesimba.es/\">\n<link rel=\"icon\" type=\"image/png\" href=\"images/Letrero2.png\">\n<link rel=\"apple-touch-icon\" href=\"images/Letrero2.png\">\n\n<!-- Open Graph -->\n<meta property=\"og:type\" content=\"business.business\">\n<meta property=\"og:title\" content=\"La Casita de Simba | Guarderia Canina Diurna sin Jaulas en Madrid\">\n<meta property=\"og:description\" content=\"Guarderia canina premium en Madrid. Sin jaulas, cuidado personalizado, fotos diarias y recogida a domicilio. ¡Consulta precios y reserva tu plaza!\">\n<meta property=\"og:url\" content=\"https://lacasitadesimba.es/\">\n<meta property=\"og:image\" content=\"https://lacasitadesimba.es/images/simbaperfil.JPG\">\n<meta property=\"og:locale\" content=\"es_ES\">\n<meta property=\"og:site_name\" content=\"La Casita de Simba\">\n\n<!-- Twitter Card -->\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name